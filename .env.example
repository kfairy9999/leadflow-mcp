# SQLite file. Use ":memory:" for a throwaway database.
LEADFLOW_DB=./data/leadflow.sqlite

# auto: seed fictional data when the database has no leads
# always: wipe and reseed (destructive)
# never: leave the database empty
LEADFLOW_SEED=auto

# debug | info | warn | error
LEADFLOW_LOG_LEVEL=info

# Streamable HTTP bind. Defaults are loopback-only.
LEADFLOW_HTTP_HOST=127.0.0.1
LEADFLOW_HTTP_PORT=8787

# Open leads with no activity for this many days count as stale.
LEADFLOW_STALE_DAYS=7

# Optional pinned clock for reproducible demos (ISO-8601).
# LEADFLOW_NOW=2026-11-18T15:00:00.000Z
