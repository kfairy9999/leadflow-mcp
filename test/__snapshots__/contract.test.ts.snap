        "required": [
          "followUpId",
          "status",
        ],
        "type": "object",
      },
      "name": "set_follow_up_status",
      "title": "Set follow-up status",
    },
    {
      "annotations": {
        "destructiveHint": false,
        "idempotentHint": false,
        "openWorldHint": false,
        "readOnlyHint": false,
      },
      "description": "Change fields on one lead. Send only the fields that change. Pass expectedUpdatedAt from the last read to reject a stale write. Null clears phone, email, city, or notes. Money stays in integer cents.",
      "inputSchema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "properties": {
          "city": {
            "anyOf": [
              {
                "maxLength": 80,
                "minLength": 1,
                "type": "string",
              },
              {
                "type": "null",
              },
            ],
          },
          "contactName": {
            "maxLength": 120,
            "minLength": 1,
            "type": "string",
          },
          "email": {
            "anyOf": [
              {
                "format": "email",
                "maxLength": 200,
                "pattern": "^(?:[A-Za-z0-9_'+\\-]+\\.)*[A-Za-z0-9_'+\\-]*[A-Za-z0-9_+-]@(?:[A-Za-z0-9][A-Za-z0-9\\-]*\\.)+[A-Za-z]{2,}$",
                "type": "string",
              },
              {
                "type": "null",
              },
            ],
            "description": "Null clears the email address.",
          },
          "estimatedValueCents": {
            "maximum": 100000000,
            "minimum": 0,
            "type": "integer",
          },
          "expectedUpdatedAt": {
            "description": "Optimistic concurrency token. Pass the updatedAt you last read. The update is rejected if the lead changed.",
            "type": "string",
          },
          "leadId": {
            "maxLength": 80,
            "minLength": 1,
            "pattern": "^[A-Za-z0-9_-]+$",
            "type": "string",
          },
          "notes": {
            "anyOf": [
              {
                "maxLength": 4000,
                "type": "string",
              },
              {
                "type": "null",
              },
            ],
          },
          "phone": {
            "anyOf": [
              {
                "maxLength": 20,
                "minLength": 7,
                "pattern": "^[0-9+().\\-\\s]+$",
                "type": "string",
              },
              {
                "type": "null",
              },
            ],
            "description": "Null clears the phone number.",
          },
          "service": {
            "maxLength": 200,
            "minLength": 1,
