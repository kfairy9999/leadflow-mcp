        ],
        "type": "object",
      },
      "name": "get_lead",
      "title": "Get lead",
    },
    {
      "annotations": {
        "destructiveHint": false,
        "idempotentHint": true,
        "openWorldHint": false,
        "readOnlyHint": true,
      },
      "description": "List scheduled follow-ups whose dueAt is at or before asOf (default: server clock). Ordered soonest first. This is the front desk call list.",
      "inputSchema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "properties": {
          "asOf": {
            "description": "Include follow-ups due at or before this instant. Default is the server clock.",
            "type": "string",
          },
          "limit": {
            "description": "Default 50.",
            "maximum": 200,
            "minimum": 1,
            "type": "integer",
          },
        },
        "type": "object",
      },
      "name": "list_due_follow_ups",
      "title": "List due follow-ups",
    },
    {
      "annotations": {
        "destructiveHint": false,
        "idempotentHint": true,
        "openWorldHint": false,
        "readOnlyHint": false,
      },
      "description": "Record a call, email, SMS, visit, or note on a lead. Summary should be the facts of the conversation, not a guess. Pass an idempotencyKey on retry. Omitting occurredAt stamps the server clock, and that default is not part of the idempotency hash. A supplied occurredAt is stored as UTC. The lead updatedAt stays on the server clock, so a backdated note does not sink the lead in search.",
      "inputSchema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "properties": {
          "channel": {
            "enum": [
              "call",
              "email",
              "sms",
              "visit",
              "note",
            ],
            "type": "string",
          },
          "direction": {
            "enum": [
              "inbound",
              "outbound",
            ],
            "type": "string",
          },
          "idempotencyKey": {
            "maxLength": 80,
            "minLength": 8,
            "pattern": "^[A-Za-z0-9_.:-]+$",
            "type": "string",
          },
          "leadId": {
            "maxLength": 80,
            "minLength": 1,
            "pattern": "^[A-Za-z0-9_-]+$",
            "type": "string",
          },
          "occurredAt": {
            "description": "When it happened. Default is the server clock.",
            "type": "string",
          },
          "summary": {
            "description": "What was said. Facts only.",
            "maxLength": 2000,
            "minLength": 1,
            "type": "string",
          },
        },
        "required": [
          "leadId",
          "channel",
          "direction",
          "summary",
        ],
        "type": "object",
      },
      "name": "log_interaction",
      "title": "Log interaction",
    },
    {
      "annotations": {
        "destructiveHint": false,
        "idempotentHint": true,
        "openWorldHint": false,
        "readOnlyHint": true,
      },
      "description": "Counts by stage, open pipeline value in cents, win rate among closed leads (won / (won + lost)), and open leads with no activity for staleAfterDays (default 7). Win rate is null when nothing has closed.",
      "inputSchema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "properties": {
          "asOf": {
            "type": "string",
          },
          "staleAfterDays": {
            "description": "Open leads with no activity for this many days are stale. Default 7.",
            "maximum": 90,
            "minimum": 1,
            "type": "integer",
          },
        },
        "type": "object",
      },
      "name": "pipeline_summary",
      "title": "Pipeline summary",
    },
    {
      "annotations": {
        "destructiveHint": false,
        "idempotentHint": true,
        "openWorldHint": false,
        "readOnlyHint": false,
      },
      "description": "Schedule a follow-up for a lead. dueAt may be in the past, which makes it due immediately. Offset and Z spellings of the same instant are equivalent, including for the idempotency key. Pass an idempotencyKey on retry.",
      "inputSchema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "properties": {
          "dueAt": {
            "description": "Allowed in the past. Past items show up in list_due_follow_ups immediately. Offset and Z spellings of the same instant are the same due time.",
            "type": "string",
          },
          "idempotencyKey": {
            "maxLength": 80,
            "minLength": 8,
            "pattern": "^[A-Za-z0-9_.:-]+$",
            "type": "string",
          },
          "leadId": {
            "maxLength": 80,
            "minLength": 1,
            "pattern": "^[A-Za-z0-9_-]+$",
            "type": "string",
          },
          "reason": {
            "maxLength": 500,
            "minLength": 1,
            "type": "string",
          },
        },
        "required": [
          "leadId",
          "dueAt",
          "reason",
        ],
        "type": "object",
      },
      "name": "schedule_follow_up",
      "title": "Schedule follow-up",
    },
    {
      "annotations": {
        "destructiveHint": false,
        "idempotentHint": true,
        "openWorldHint": false,
        "readOnlyHint": true,
      },
      "description": "Explain the priority score for one lead. The score is a published sum of source, reachability, urgency, value, stage, and recency, then a cap. It is not persisted and it does not call a model. Read leadflow://scoring-model for the rubric.",
      "inputSchema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "properties": {
          "asOf": {
            "description": "Score as of this instant. Default is the server clock.",
            "type": "string",
          },
          "leadId": {
            "maxLength": 80,
            "minLength": 1,
            "pattern": "^[A-Za-z0-9_-]+$",
            "type": "string",
          },
        },
        "required": [
          "leadId",
        ],
        "type": "object",
      },
      "name": "score_lead",
      "title": "Score lead",
    },
    {
      "annotations": {
        "destructiveHint": false,
        "idempotentHint": true,
        "openWorldHint": false,
        "readOnlyHint": true,
      },
      "description": "Search the pipeline. Text matches name, service, city, email, phone, and notes, case-insensitive for ASCII. Results are ranked inside the 500 most recently updated matches. When truncated is true, narrow the query. Scores are computed, not stored.",
      "inputSchema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "properties": {
          "limit": {
            "description": "Page size. Default 25.",
            "maximum": 100,
            "minimum": 1,
            "type": "integer",
          },
          "minScore": {
            "description": "Inclusive priority score floor. Applied after the scan.",
            "maximum": 100,
            "minimum": 0,
            "type": "integer",
          },
          "offset": {
            "description": "Default 0.",
            "maximum": 10000,
            "minimum": 0,
            "type": "integer",
          },
          "sort": {
            "description": "Default updated_at, newest first.",
            "enum": [
              "updated_at",
              "created_at",
              "value",
              "score",
            ],
            "type": "string",
          },
          "source": {
            "enum": [
              "referral",
              "website",
              "phone",
              "walk_in",
              "other",
            ],
            "type": "string",
          },
          "stage": {
            "enum": [
              "new",
              "contacted",
              "qualified",
              "proposal",
              "won",
              "lost",
            ],
            "type": "string",
          },
          "text": {
            "description": "Case-insensitive ASCII match on name, service, city, email, phone, and notes.",
            "maxLength": 200,
            "type": "string",
          },
        },
        "type": "object",
      },
      "name": "search_leads",
      "title": "Search leads",
    },
    {
      "annotations": {
        "destructiveHint": false,
        "idempotentHint": true,
        "openWorldHint": false,
        "readOnlyHint": false,
      },
      "description": "Mark a follow-up scheduled, done, or cancelled. Setting the same status again is safe and does not rewrite the lead. Done and cancelled items drop out of list_due_follow_ups.",
      "inputSchema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "properties": {
          "followUpId": {
            "maxLength": 80,
            "minLength": 1,
            "pattern": "^[A-Za-z0-9_-]+$",
            "type": "string",
          },
          "status": {
            "enum": [
              "scheduled",
              "done",
              "cancelled",
            ],
            "type": "string",
          },
