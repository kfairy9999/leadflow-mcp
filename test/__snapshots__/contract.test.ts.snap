    },
    {
      "description": "contacted · Water heater flush",
      "mimeType": "application/json",
      "name": "Samira Adeyemi",
      "title": "Lead",
      "uri": "leadflow://leads/lead_samira_adeyemi",
    },
    {
      "description": "Stage counts, win rate, open value, and stale leads as JSON.",
      "mimeType": "application/json",
      "name": "pipeline",
      "title": "Pipeline snapshot",
      "uri": "leadflow://pipeline",
    },
    {
      "description": "The published point rubric used by score_lead. No model is called.",
      "mimeType": "text/markdown",
      "name": "scoring_model",
      "title": "Scoring model",
      "uri": "leadflow://scoring-model",
    },
  ],
  "tools": [
    {
      "annotations": {
        "destructiveHint": false,
        "idempotentHint": false,
        "openWorldHint": false,
        "readOnlyHint": false,
      },
      "description": "Add a lead to the shop pipeline. Money is integer cents (480000 = $4,800.00), never dollars. Pass an idempotencyKey when retrying so a duplicate submit returns the original lead. A reused key with a different payload is a conflict. The response includes the rule-based priority score.",
      "inputSchema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "properties": {
          "city": {
            "anyOf": [
              {
                "maxLength": 80,
                "minLength": 1,
                "type": "string",
              },
              {
                "type": "null",
              },
            ],
          },
          "contactName": {
            "description": "Person to call back. Not a company name.",
            "maxLength": 120,
            "minLength": 1,
            "type": "string",
          },
          "email": {
            "anyOf": [
              {
                "format": "email",
                "maxLength": 200,
                "pattern": "^(?:[A-Za-z0-9_'+\\-]+\\.)*[A-Za-z0-9_'+\\-]*[A-Za-z0-9_+-]@(?:[A-Za-z0-9][A-Za-z0-9\\-]*\\.)+[A-Za-z]{2,}$",
                "type": "string",
              },
              {
                "type": "null",
              },
            ],
            "description": "Optional. Use null when the caller did not give one.",
          },
          "estimatedValueCents": {
            "description": "Integer cents, not dollars. 480000 means $4,800.00. Use 0 when unknown.",
            "maximum": 100000000,
            "minimum": 0,
            "type": "integer",
          },
          "idempotencyKey": {
            "description": "Send the same key on retry to avoid a duplicate lead. A different payload with the same key is a conflict.",
            "maxLength": 80,
            "minLength": 8,
            "pattern": "^[A-Za-z0-9_.:-]+$",
            "type": "string",
          },
          "notes": {
            "anyOf": [
              {
                "maxLength": 4000,
                "type": "string",
              },
              {
                "type": "null",
              },
            ],
          },
          "phone": {
            "anyOf": [
              {
                "maxLength": 20,
                "minLength": 7,
                "pattern": "^[0-9+().\\-\\s]+$",
                "type": "string",
              },
              {
                "type": "null",
              },
            ],
            "description": "Optional. Digits, spaces, and + ( ) . - only.",
          },
          "service": {
            "description": "The job in the customer’s words.",
            "maxLength": 200,
            "minLength": 1,
            "type": "string",
          },
          "source": {
            "description": "How the lead arrived.",
            "enum": [
              "referral",
              "website",
              "phone",
              "walk_in",
              "other",
            ],
            "type": "string",
          },
          "stage": {
            "description": "Defaults to new.",
            "enum": [
              "new",
              "contacted",
              "qualified",
              "proposal",
              "won",
              "lost",
            ],
            "type": "string",
          },
          "urgency": {
            "description": "Defaults to normal.",
            "enum": [
              "low",
              "normal",
              "high",
            ],
            "type": "string",
          },
        },
        "required": [
          "contactName",
          "service",
          "source",
        ],
        "type": "object",
      },
      "name": "create_lead",
      "title": "Create lead",
    },
    {
      "annotations": {
        "destructiveHint": false,
        "idempotentHint": true,
        "openWorldHint": false,
        "readOnlyHint": true,
      },
      "description": "Export leads as CSV text. Cells that start with =, +, -, or @, including after leading whitespace, tab, or CR, are prefixed with an apostrophe so a spreadsheet will not treat them as formulas. Quotes, commas, and newlines are escaped. The export caps at 5000 rows and sets truncated when that happens. Money is integer cents.",
      "inputSchema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "properties": {
          "asOf": {
            "type": "string",
          },
          "stage": {
            "enum": [
              "new",
              "contacted",
              "qualified",
              "proposal",
              "won",
              "lost",
            ],
            "type": "string",
          },
        },
        "type": "object",
      },
      "name": "export_leads_csv",
      "title": "Export leads CSV",
    },
    {
      "annotations": {
        "destructiveHint": false,
        "idempotentHint": true,
        "openWorldHint": false,
        "readOnlyHint": true,
      },
      "description": "Read one lead with its priority score, interactions, and follow-ups. Use this before drafting outreach so the reply stays inside the recorded facts.",
      "inputSchema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "properties": {
