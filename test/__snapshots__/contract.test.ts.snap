exports[`MCP contract > snapshots tools/list, resources/list, and prompts/list 1`] = `
{
  "prompts": [
    {
      "arguments": [
        {
          "description": "Days without activity before an open lead is stale. Prompt arguments arrive as strings. Default is the server setting.",
          "name": "staleAfterDays",
          "required": false,
        },
        {
          "description": "Voice for the drafted lines. Default friendly.",
          "name": "tone",
          "required": false,
        },
      ],
      "description": "Build a front-desk briefing from the live pipeline and the follow-ups that are due. The model must not invent prices, times, or promises.",
      "name": "daily_follow_up_briefing",
      "title": "Daily follow-up briefing",
    },
    {
      "arguments": [
        {
          "description": "Lead id, for example lead_marina_cho.",
          "name": "leadId",
          "required": true,
        },
        {
          "description": "Channel to draft for. Default call.",
          "name": "channel",
          "required": false,
        },
        {
          "description": "Default friendly.",
          "name": "tone",
          "required": false,
        },
      ],
      "description": "Draft a follow-up for one lead from the recorded facts. The model must not invent discounts or appointment times.",
      "name": "draft_follow_up",
      "title": "Draft follow-up",
    },
  ],
  "resourceTemplates": [
    {
      "description": "One lead, its score, interactions, and follow-ups, as JSON.",
      "mimeType": "application/json",
      "name": "lead",
      "title": "Lead",
      "uriTemplate": "leadflow://leads/{leadId}",
    },
  ],
  "resources": [
    {
      "description": "lost · Whole-house repipe quote",
      "mimeType": "application/json",
